# ===========================
# Ticker — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ===========================

# --- Database ---
# SQLite (default for local development — the path below is relative to project root)
DATABASE_URL=sqlite:///./ticker.db

# PostgreSQL via NeonDB (optional, for later deployment upgrade)
# DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host/ticker

# --- Groq API ---
# Obtain from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- Groq model identifier ---
# Verify the current supported model at https://console.groq.com/docs/models
# llama-3.1-8b-instant is deprecated — use the currently listed equivalent
GROQ_MODEL=llama-3.3-70b-versatile

# --- Backend API ---
# The URL that the Streamlit frontend uses to talk to FastAPI
API_BASE_URL=http://localhost:8000

# --- Retrieval tuning ---
# Minimum cosine-similarity score for a ticket match to be considered relevant
# Range: 0.0 – 1.0   Typical starting value: 0.1
SIMILARITY_THRESHOLD=0.1

# --- Application behaviour ---
# Maximum characters accepted in a single issue description submission
MAX_ISSUE_LENGTH=2000

# Maximum number of historical tickets returned by GET /tickets
TICKETS_PAGE_LIMIT=100
